[Unit]
Description=GitHub Webhook + AI Chat Proxy for yaoguayi.com
After=network.target

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/etc/yaoguayi/env
ExecStart=/usr/bin/python3 /var/www/yaoguayi/deploy/webhook.py
WorkingDirectory=/var/www/yaoguayi
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
