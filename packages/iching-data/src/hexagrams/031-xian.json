  "lowerTrigram": "艮",
  "guaci": "亨，利貞，取女吉。",
  "tuan": "咸，感也。柔上而剛下，二氣感應以相與，止而說，男下女，是以亨，利貞，取女吉也。天地感而萬物化生，聖人感人心而天下和平。觀其所感，而天地萬物之情可見矣。",
  "xiang": "山上有澤，咸。君子以虛受人。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：咸其拇。",
      "xiang": "咸其拇，志在外也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：咸其腓，凶，居吉。",
      "xiang": "雖凶居吉，順不害也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：咸其股，執其隨，往吝。",
      "xiang": "咸其股，亦不處也。志在隨人，所執下也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：貞吉悔亡，憧憧往來，朋從爾思。",
      "xiang": "貞吉悔亡，未感害也。憧憧往來，未光大也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：咸其脢，無悔。",
      "xiang": "咸其脢，志末也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：咸其輔頰舌。",
      "xiang": "咸其輔頰舌，滕口說也。"
    }
  ],
