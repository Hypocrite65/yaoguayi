  "upperTrigram": "坎",
  "lowerTrigram": "艮",
  "guaci": "利西南，不利東北，利見大人，貞吉。",
  "tuan": "蹇，難也，險在前也。見險而能止，知矣哉！蹇，利西南，往得中也。不利東北，其道窮也。利見大人，往有功也。當位貞吉，以正邦也。蹇之時用大矣哉！",
  "xiang": "山上有水，蹇。君子以反身修德。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：往蹇，來譽。",
      "xiang": "往蹇來譽，宜待也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：王臣蹇蹇，匪躬之故。",
      "xiang": "王臣蹇蹇，終無尤也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：往蹇，來反。",
      "xiang": "往蹇來反，內喜之也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：往蹇，來連。",
      "xiang": "往蹇來連，當位實也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：大蹇，朋來。",
      "xiang": "大蹇朋來，以中節也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：往蹇，來碩，吉，利見大人。",
      "xiang": "往蹇來碩，志在內也。利見大人，以從貴也。"
    }
  ],
