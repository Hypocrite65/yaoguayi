  "upperTrigram": "乾",
  "lowerTrigram": "兌",
  "guaci": "履虎尾，不咥人，亨。",
  "tuan": "履，柔履剛也。說而應乎乾，是以履虎尾，不咥人，亨。剛中正，履帝位而不疚，光明也。",
  "xiang": "上天下澤，履。君子以辨上下，定民志。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：素履往，無咎。",
      "xiang": "素履之往，獨行愿也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：履道坦坦，幽人貞吉。",
      "xiang": "幽人貞吉，中不自亂也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：眇能視，跛能履，履虎尾，咥人，凶。武人為于大君。",
      "xiang": "眇能視，不足以有明也。跛能履，不足以與行也。咥人之凶，位不當也。武人為于大君，志剛也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：履虎尾，愬愬，終吉。",
      "xiang": "愬愬終吉，志行也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：夬履，貞厲。",
      "xiang": "夬履貞厲，位正當也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：視履考祥，其旋元吉。",
      "xiang": "元吉在上，大有慶也。"
    }
  ],
