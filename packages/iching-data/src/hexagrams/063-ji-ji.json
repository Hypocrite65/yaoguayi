  "guaci": "亨，小利貞，初吉終亂。",
  "tuan": "既濟，亨，小者亨也。利貞，剛柔正而位當也。初吉，柔得中也。終止則亂，其道窮也。",
  "xiang": "水在火上，既濟。君子以思患而預防之。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：曳其輪，濡其尾，無咎。",
      "xiang": "曳其輪，義無咎也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：婦喪其茀，勿逐，七日得。",
      "xiang": "七日得，以中道也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：高宗伐鬼方，三年克之，小人勿用。",
      "xiang": "三年克之，憊也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：繻有衣袽，終日戒。",
      "xiang": "終日戒，有所疑也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：東鄰殺牛，不如西鄰之禴祭，實受其福。",
      "xiang": "東鄰殺牛，不如西鄰之時也。實受其福，吉，大來也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：濡其首，厲。",
      "xiang": "濡其首厲，何可久也。"
    }
  ],
