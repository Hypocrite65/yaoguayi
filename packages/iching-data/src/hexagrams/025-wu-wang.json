  "upperTrigram": "艮",
  "lowerTrigram": "乾",
  "guaci": "元，亨，利，貞。其匪正有眚，不利有攸往。",
  "tuan": "無妄，剛自外來而為主于內，動而健，剛中而應，大亨以正，天之命也。其匪正有眚，不利有攸往，無妄之往，何之矣？天命不祐，行矣哉！",
  "xiang": "天下雷行，物與無妄，先王以茂對時，育萬物。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：無妄，往吉。",
      "xiang": "無妄之往，得志也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：不耕穫，不菑畬，則利有攸往。",
      "xiang": "不耕穫，未富也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：無妄之災，或係之牛，行人之得，邑人之災。",
      "xiang": "行人得牛，邑人災也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：可貞，無咎。",
      "xiang": "可貞無咎，固有之也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：無妄之疾，勿藥有喜。",
      "xiang": "無妄之藥，不可試也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：無妄，行有眚，無攸利。",
      "xiang": "無妄之行，窮之災也。"
    }
  ],
  "aiSummary": ""
