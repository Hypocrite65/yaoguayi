  ],
  "upperTrigram": "巽",
  "lowerTrigram": "離",
  "guaci": "利女貞。",
  "tuan": "家人，女正位乎內，男正位乎外，男女正，天地之大義也。家人有嚴君焉，父母之謂也。父父，子子，兄兄，弟弟，夫夫，婦婦，而家道正，正家而天下定矣。",
  "xiang": "風自火出，家人。君子以言有物而行有恆。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：閑有家，悔亡。",
      "xiang": "閑有家，志未變也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：無攸遂，在中饋，貞吉。",
      "xiang": "六二之吉，順以巽也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：家人嗃嗃，悔厲吉，婦子嘻嘻，終吝。",
      "xiang": "家人嗃嗃，未失也。婦子嘻嘻，失家節也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：富家，大吉。",
      "xiang": "富家大吉，順在位也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：王假有家，勿恤，吉。",
      "xiang": "王假有家，交相愛也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：有孚威如，終吉。",
      "xiang": "威如之吉，反身之謂也。"
    }
  ],
  "aiSummary": ""
}