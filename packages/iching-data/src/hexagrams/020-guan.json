  "upperTrigram": "巽",
  "lowerTrigram": "坤",
  "guaci": "盥而不薦，有孚顒若。",
  "tuan": "大觀在上，順而巽，中正以觀天下。觀，盥而不薦，有孚顒若，下觀而化也。觀天之神道，而四時不忒，聖人以神道設教，而天下服矣。",
  "xiang": "風行地上，觀。先王以省方觀民設教。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：童觀，小人無咎，君子吝。",
      "xiang": "初六童觀，小人道也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：闚觀，利女貞。",
      "xiang": "闚觀女貞，亦可醜也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：觀我生，進退。",
      "xiang": "觀我生進退，未失道也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：觀國之光，利用賓于王。",
      "xiang": "觀國之光，尚賓也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：觀我生，君子無咎。",
      "xiang": "觀我生，觀民也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：觀其生，君子無咎。",
      "xiang": "觀其生，志未平也。"
    }
  ],
