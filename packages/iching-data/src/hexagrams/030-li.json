  "upperTrigram": "離",
  "lowerTrigram": "離",
  "guaci": "利貞，亨。畜牝牛，吉。",
  "tuan": "離，麗也。日月麗乎天，百穀草木麗乎土，重明以麗乎正，乃化成天下。柔麗乎中正，故亨，是以畜牝牛吉也。",
  "xiang": "明兩作，離。大人以繼明照于四方。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：履錯然，敬之，無咎。",
      "xiang": "履錯之敬，以辟咎也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：黃離，元吉。",
      "xiang": "黃離元吉，得中道也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：日昃之離，不鼓缶而歌，則大耋之嗟，凶。",
      "xiang": "日昃之離，何可久也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：突如其來如，焚如，死如，棄如。",
      "xiang": "突如其來如，無所容也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：出涕沱若，戚嗟若，吉。",
      "xiang": "六五之吉，離王公也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：王用出征，有嘉折首，獲匪其醜，無咎。",
      "xiang": "王用出征，以正邦也。"
    }
  ],
