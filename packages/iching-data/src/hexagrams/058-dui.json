  "guaci": "亨，利貞。",
  "tuan": "兌，說也，剛中而柔外，說以利貞，是以順乎天而應乎人。說以先民，民忘其勞；說以犯難，民忘其死；說之大，民勸矣哉！",
  "xiang": "麗澤，兌。君子以朋友講習。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：和兌，吉。",
      "xiang": "和兌之吉，行未疑也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：孚兌，吉，悔亡。",
      "xiang": "孚兌之吉，信志也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：來兌，凶。",
      "xiang": "來兌之凶，位不當也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：商兌未寧，介疾有喜。",
      "xiang": "九四之喜，有慶也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：孚于剝，有厲。",
      "xiang": "孚于剝，位正當也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：引兌。",
      "xiang": "上六引兌，未光也。"
    }
