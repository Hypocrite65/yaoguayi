  "guaci": "亨，小狐汔濟，濡其尾，無攸利。",
  "tuan": "未濟，亨，柔得中也。小狐汔濟，未出中也。濡其尾，無攸利，不續終也。雖不當位，剛柔應也。",
  "xiang": "火在水上，未濟。君子以慎辨物居方。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：濡其尾，吝。",
      "xiang": "濡其尾，亦不知極也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：曳其輪，貞吉。",
      "xiang": "九二貞吉，中以行正也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：未濟，征凶，利涉大川。",
      "xiang": "未濟征凶，位不當也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：貞吉，悔亡，震用伐鬼方，三年有賞于大國。",
      "xiang": "貞吉悔亡，志行也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：貞吉，無悔，君子之光，有孚，吉。",
      "xiang": "君子之光，其暉吉也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：有孚于飲酒，無咎，濡其首，有孚失是。",
      "xiang": "飲酒濡首，亦不知節也。"
    }
  ],
