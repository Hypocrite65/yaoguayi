  "upperTrigram": "坤",
  "lowerTrigram": "震",
  "guaci": "亨。出入無疾，朋來無咎。反復其道，七日來復，利有攸往。",
  "tuan": "復，亨，剛反，動而以順行，是以出入無疾，朋來無咎。反復其道，七日來復，天行也。利有攸往，剛長也。復，其見天地之心乎？",
  "xiang": "雷在地中，復。先王以至日閉關，商旅不行，後不省方。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：不遠復，無祇悔，元吉。",
      "xiang": "不遠之復，以修身也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：休復，吉。",
      "xiang": "休復之吉，以下仁也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：頻復，厲無咎。",
      "xiang": "頻復之厲，義無咎也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：中行獨復。",
      "xiang": "中行獨復，以從道也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：敦復，無悔。",
      "xiang": "敦復無悔，中以自考也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：迷復，凶，有災眚。用行師，終有大敗，以其國，君凶，至于十年不克征。",
      "xiang": "迷復之凶，反君道也。"
    }
  ],
  "aiSummary": ""
