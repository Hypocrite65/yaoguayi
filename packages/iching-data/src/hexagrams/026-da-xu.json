  "upperTrigram": "乾",
  "lowerTrigram": "震",
  "guaci": "利貞，不家食，吉，利涉大川。",
  "tuan": "大畜，剛健篤實，輝光日新其德。剛上而尚賢，能止健，大正也。不家食，吉，養賢也。利涉大川，應乎天也。",
  "xiang": "天在山中，大畜。君子以多識前言往行，以畜其德。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：有厲，利己。",
      "xiang": "有厲利己，不犯災也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：輿說輹。",
      "xiang": "輿說輹，中無尤也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：良馬逐，利艱貞。曰閑輿衛，利有攸往。",
      "xiang": "利有攸往，上合志也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：童牛之牿，元吉。",
      "xiang": "六四元吉，有喜也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：豶豕之牙，吉。",
      "xiang": "六五之吉，有慶也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：何天之衢，亨。",
      "xiang": "何天之衢，道大行也。"
    }
  ],
