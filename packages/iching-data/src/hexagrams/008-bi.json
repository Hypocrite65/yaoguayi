  "guaci": "吉，原筮，元永貞，無咎。不寧方來，後夫凶。",
  "tuan": "比，吉也，比，輔也，下順從也。原筮，元永貞，無咎，以剛中也。不寧方來，上下應也。後夫凶，其道窮也。",
  "xiang": "地上有水，比。先王以建萬國，親諸侯。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：有孚比之，無咎。有孚盈缶，終來有他吉。",
      "xiang": "比之初六，有他吉也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：比之自內，貞吉。",
      "xiang": "比之自內，不自失也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：比之匪人。",
      "xiang": "比之匪人，不亦傷乎。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：外比之，貞吉。",
      "xiang": "外比于賢，以從上也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：顯比，王用三驅，失前禽，邑人不誡，吉。",
      "xiang": "顯比之吉，位正中也。舍逆取順，失前禽也。邑人不誡，上使中也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：比之無首，凶。",
      "xiang": "比之無首，無所終也。"
    }
  ],
  "aiSummary": ""
