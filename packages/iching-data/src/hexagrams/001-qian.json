  "upperTrigram": "乾",
  "lowerTrigram": "乾",
  "guaci": "元，亨，利，貞。",
  "tuan": "大哉乾元，萬物資始，乃統天。雲行雨施，品物流形。大明始終，六位時成，時乘六龍以御天。乾道變化，各正性命，保合太和，乃利貞。首出庶物，萬國咸寧。",
  "xiang": "天行健，君子以自強不息。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：潛龍勿用。",
      "xiang": "潛龍勿用，陽在下也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：見龍在田，利見大人。",
      "xiang": "見龍在田，德施普也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：君子終日乾乾，夕惕若厲，無咎。",
      "xiang": "終日乾乾，反復道也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：或躍在淵，無咎。",
      "xiang": "或躍在淵，進無咎也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：飛龍在天，利見大人。",
      "xiang": "飛龍在天，大人造也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：亢龍有悔。",
      "xiang": "亢龍有悔，盈不可久也。"
    },
    {
      "position": 7,
      "name": "用九",
      "text": "用九：見群龍無首，吉。",
      "xiang": "用九，天德不可為首也。"
    }
  ],
