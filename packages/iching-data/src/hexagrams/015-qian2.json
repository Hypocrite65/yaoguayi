  "upperTrigram": "坤",
  "lowerTrigram": "艮",
  "guaci": "亨，君子有終。",
  "tuan": "謙，亨，天道下濟而光明，地道卑而上行。天道虧盈而益謙，地道變盈而流謙，鬼神害盈而福謙，人道惡盈而好謙。謙，尊而光，卑而不可踰，君子之終也。",
  "xiang": "地中有山，謙。君子以裒多益寡，稱物平施。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：謙謙君子，用涉大川，吉。",
      "xiang": "謙謙君子，卑以自牧也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：鳴謙，貞吉。",
      "xiang": "鳴謙貞吉，中心得也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：勞謙君子，有終，吉。",
      "xiang": "勞謙君子，萬民服也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：無不利，撝謙。",
      "xiang": "無不利撝謙，不違則也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：不富以其鄰，利用侵伐，無不利。",
      "xiang": "利用侵伐，征不服也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：鳴謙，利用行師，征邑國。",
      "xiang": "鳴謙，志未得也。可用行師，征邑國也。"
    }
  ],
