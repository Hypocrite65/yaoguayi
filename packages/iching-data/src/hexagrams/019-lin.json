  "guaci": "元，亨，利，貞。至于八月有凶。",
  "tuan": "臨，剛浸而長，說而順，剛中而應，大亨以正，天之道也。至于八月有凶，消不久也。",
  "xiang": "澤上有地，臨。君子以教思無窮，容保民無疆。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：咸臨，貞吉。",
      "xiang": "咸臨貞吉，志行正也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：咸臨，吉，無不利。",
      "xiang": "咸臨吉無不利，未順命也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：甘臨，無攸利，既憂之，無咎。",
      "xiang": "甘臨，位不當也。既憂之，咎不長也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：至臨，無咎。",
      "xiang": "至臨無咎，位當也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：知臨，大君之宜，吉。",
      "xiang": "大君之宜，行中之謂也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：敦臨，吉，無咎。",
      "xiang": "敦臨之吉，志在內也。"
    }
  ],
