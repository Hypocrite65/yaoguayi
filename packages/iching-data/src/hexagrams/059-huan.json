  "guaci": "亨，王假有廟，利涉大川，利貞。",
  "tuan": "渙，亨，剛來而不窮，柔得位乎外而上同。王假有廟，王乃在中也。利涉大川，乘木有功也。",
  "xiang": "風行水上，渙。先王以享于帝，立廟。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：用拯馬壯，吉。",
      "xiang": "初六之吉，順也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：渙奔其機，悔亡。",
      "xiang": "渙奔其機，得愿也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：渙其躬，無悔。",
      "xiang": "渙其躬，志在外也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：渙其群，元吉；渙有丘，匪夷所思。",
      "xiang": "渙其群元吉，光大也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：渙汗其大號，渙王居，無咎。",
      "xiang": "王居無咎，正位也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：渙其血，去逖出，無咎。",
      "xiang": "渙其血，遠害也。"
    }
  ],
