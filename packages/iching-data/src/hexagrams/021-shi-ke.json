  "guaci": "亨，利用獄。",
  "tuan": "頤中有物，曰噬嗑。噬嗑而亨。剛柔分，動而明，雷電合而章。柔得中而上行，雖不當位，利用獄也。",
  "xiang": "雷電噬嗑，君子以明罰敕法。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：屨校滅趾，無咎。",
      "xiang": "屨校滅趾，不行也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：噬膚滅鼻，無咎。",
      "xiang": "噬膚滅鼻，乘剛也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：噬腊肉，遇毒，小吝，無咎。",
      "xiang": "遇毒，位不當也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：噬乾胏，得金矢，利艱貞，吉。",
      "xiang": "利艱貞吉，未光也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：噬乾肉，得黃金，貞厲，無咎。",
      "xiang": "貞厲無咎，得當也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：何校滅耳，凶。",
      "xiang": "何校滅耳，聰不明也。"
    }
  ],
