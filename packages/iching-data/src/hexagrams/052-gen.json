  "upperTrigram": "艮",
  "lowerTrigram": "艮",
  "guaci": "艮其背，不獲其身，行其庭，不見其人，無咎。",
  "tuan": "艮，止也。時止則止，時行則行，動靜不失其時，其道光明。艮其止，止其所也。上下敵應，不相與也，是以不獲其身，行其庭不見其人，無咎也。",
  "xiang": "兼山，艮。君子以思不出其位。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：艮其趾，無咎，利永貞。",
      "xiang": "艮其趾，未失正也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：艮其腓，不拯其隨，其心不快。",
      "xiang": "不拯其隨，未退聽也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：艮其限，列其夤，厲薰心。",
      "xiang": "艮其限，危薰心也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：艮其身，無咎。",
      "xiang": "艮其身，止諸躬也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：艮其輔，言有序，悔亡。",
      "xiang": "艮其輔，以中正也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：敦艮，吉。",
      "xiang": "敦艮之吉，以厚終也。"
    }
  ],
  "aiSummary": ""
