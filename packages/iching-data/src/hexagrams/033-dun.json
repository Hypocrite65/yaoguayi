  "upperTrigram": "乾",
  "lowerTrigram": "艮",
  "guaci": "亨，小利貞。",
  "tuan": "遯，亨，遯而亨也。剛當位而應，與時行也。小利貞，浸而長也。遯之時義大矣哉！",
  "xiang": "天下有山，遯。君子以遠小人，不惡而嚴。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：遯尾，厲，勿用有攸往。",
      "xiang": "遯尾之厲，不往何災也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：執之用黃牛之革，莫之勝說。",
      "xiang": "執用黃牛，固志也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：係遯，有疾厲，畜臣妾，吉。",
      "xiang": "係遯之厲，有疾憊也。畜臣妾吉，不可大事也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：好遯，君子吉，小人否。",
      "xiang": "君子好遯，小人否也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：嘉遯，貞吉。",
      "xiang": "嘉遯貞吉，以正志也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：肥遯，無不利。",
      "xiang": "肥遯無不利，無所疑也。"
    }
  ],
