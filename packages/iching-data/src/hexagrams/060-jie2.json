  "upperTrigram": "坎",
  "lowerTrigram": "兌",
  "guaci": "亨，苦節不可貞。",
  "tuan": "節亨，剛柔分而剛得中。苦節不可貞，其道窮也。說以行險，當位以節，中正以通，天地節而四時成，節以制度，不傷財，不害民。",
  "xiang": "澤上有水，節。君子以制數度，議德行。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：不出戶庭，無咎。",
      "xiang": "不出戶庭，知通塞也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：不出門庭，凶。",
      "xiang": "不出門庭之凶，失時極也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：不節若，則嗟若，無咎。",
      "xiang": "不節之嗟，又誰咎也？"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：安節，亨。",
      "xiang": "安節之亨，承上道也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：甘節，吉，往有尚。",
      "xiang": "甘節之吉，居位中也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：苦節，貞凶，悔亡。",
      "xiang": "苦節貞凶，其道窮也。"
    }
  ],
