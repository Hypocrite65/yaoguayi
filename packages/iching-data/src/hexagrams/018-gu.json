  "upperTrigram": "艮",
  "lowerTrigram": "巽",
  "guaci": "元亨，利涉大川，先甲三日，後甲三日。",
  "tuan": "蠱，剛上而柔下，巽而止，蠱。蠱，元亨，而天下治也。利涉大川，往有事也。先甲三日，後甲三日，終則有始，天行也。",
  "xiang": "山下有風，蠱。君子以振民育德。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：幹父之蠱，有子，考無咎，厲終吉。",
      "xiang": "幹父之蠱，意承考也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：幹母之蠱，不可貞。",
      "xiang": "幹母之蠱，得中道也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：幹父之蠱，小有悔，無大咎。",
      "xiang": "幹父之蠱，終無咎也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：裕父之蠱，往見吝。",
      "xiang": "裕父之蠱，往未得也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：幹父之蠱，用譽。",
      "xiang": "幹父用譽，承以德也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：不事王侯，高尚其事。",
      "xiang": "不事王侯，志可則也。"
    }
  ],
  "aiSummary": ""
