  "upperTrigram": "兌",
  "lowerTrigram": "巽",
  "guaci": "棟橈，利有攸往，亨。",
  "tuan": "大過，大者過也。棟橈，本末弱也。剛過而中，巽而說行，利有攸往，乃亨。大過之時大矣哉！",
  "xiang": "澤滅木，大過。君子以獨立不懼，遯世無悶。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：藉用白茅，無咎。",
      "xiang": "藉用白茅，柔在下也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：枯楊生稊，老夫得其女妻，無不利。",
      "xiang": "老夫女妻，過以相與也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：棟橈，凶。",
      "xiang": "棟橈之凶，不可以有輔也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：棟隆，吉，有它吝。",
      "xiang": "棟隆之吉，不橈乎下也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：枯楊生華，老婦得其士夫，無咎無譽。",
      "xiang": "枯楊生華，何可久也。老婦士夫，亦可醜也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：過涉滅頂，凶，無咎。",
      "xiang": "過涉之凶，不可咎也。"
    }
  ],
