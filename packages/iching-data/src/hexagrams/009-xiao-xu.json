  ],
  "upperTrigram": "巽",
  "lowerTrigram": "乾",
  "guaci": "亨。密雲不雨，自我西郊。",
  "tuan": "小畜，柔得位而上下應之，曰小畜。健而巽，剛中而志行，乃亨。密雲不雨，尚往也。自我西郊，施未行也。",
  "xiang": "風行天上，小畜。君子以懿文德。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：復自道，何其咎，吉。",
      "xiang": "復自道，其義吉也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：牽復，吉。",
      "xiang": "牽復在中，亦不自失也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：輿說輻，夫妻反目。",
      "xiang": "夫妻反目，不能正室也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：有孚，血去惕出，無咎。",
      "xiang": "有孚惕出，上合志也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：有孚攣如，富以其鄰。",
      "xiang": "有孚攣如，不獨富也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：既雨既處，尚德載。婦貞厲，月幾望，君子征凶。",
      "xiang": "既雨既處，德積載也。君子征凶，有所疑也。"
    }
  ],
  "aiSummary": ""
}