  "upperTrigram": "艮",
  "lowerTrigram": "離",
  "guaci": "亨，小利有攸往。",
  "tuan": "賁，亨，柔來而文剛，故亨。分剛上而文柔，故小利有攸往，天文也。文明以止，人文也。觀乎天文，以察時變；觀乎人文，以化成天下。",
  "xiang": "山下有火，賁。君子以明庶政，無敢折獄。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：賁其趾，舍車而徒。",
      "xiang": "舍車而徒，義弗乘也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：賁其須。",
      "xiang": "賁其須，與上興也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：賁如濡如，永貞吉。",
      "xiang": "永貞之吉，終莫陵也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：賁如皤如，白馬翰如，匪寇婚媾。",
      "xiang": "六四，當位疑也。匪寇婚媾，終無尤也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：賁于丘園，束帛戔戔，吝，終吉。",
      "xiang": "六五之吉，有喜也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：白賁，無咎。",
      "xiang": "白賁無咎，上得志也。"
    }
  ],
