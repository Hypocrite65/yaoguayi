  "guaci": "元亨，用見大人，勿恤，南征吉。",
  "tuan": "柔以時升，巽而順，剛中而應，是以大亨，用見大人，勿恤，有慶也。南征吉，志行也。",
  "xiang": "地中生木，升。君子以順德，積小以高大。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：允升，大吉。",
      "xiang": "允升大吉，上合志也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：孚乃利用禴，無咎。",
      "xiang": "九二之孚，有喜也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：升虛邑。",
      "xiang": "升虛邑，無所疑也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：王用亨于岐山，吉，無咎。",
      "xiang": "王用亨于岐山，順事也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：貞吉，升階。",
      "xiang": "貞吉升階，大得志也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：冥升，利于不息之貞。",
      "xiang": "冥升在上，消不富也。"
