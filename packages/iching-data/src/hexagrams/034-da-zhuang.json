  "guaci": "利貞。",
  "tuan": "大壯，大者壯也，剛以動，故壯。大壯，利貞，大者正也，正大而天地之情可見矣！",
  "xiang": "雷在天上，大壯。君子以非禮弗履。",
  "yaoci": [
    {
      "position": 1,
      "name": "初九",
      "text": "初九：壯于趾，征凶，有孚。",
      "xiang": "壯于趾，其孚窮也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：貞吉。",
      "xiang": "九二貞吉，以中也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：小人用壯，君子用罔，貞厲，羝羊觸藩，羸其角。",
      "xiang": "小人用壯，君子罔也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：貞吉，悔亡，藩決不羸，壯于大輿之輹。",
      "xiang": "藩決不羸，尚往也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：喪羊于易，無悔。",
      "xiang": "喪羊于易，位不當也。"
    },
    {
      "position": 6,
      "name": "上六",
      "text": "上六：羝羊觸藩，不能退，不能遂，無攸利，艱則吉。",
      "xiang": "不能退，不能遂，不詳也。艱則吉，咎不長也。"
    }
  ],
