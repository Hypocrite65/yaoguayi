  "upperTrigram": "乾",
  "lowerTrigram": "巽",
  "guaci": "女壯，勿用取女。",
  "tuan": "姤，遇也，柔遇剛也。勿用取女，不可與長也。天地相遇，品物咸章也。剛遇中正，天下大行也。姤之時義大矣哉！",
  "xiang": "天下有風，姤。后以施命誥四方。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：係于金柅，貞吉，有攸往，見凶，羸豕孚蹢躅。",
      "xiang": "係于金柅，柔道牽也。"
    },
    {
      "position": 2,
      "name": "九二",
      "text": "九二：包有魚，無咎，不利賓。",
      "xiang": "包有魚，義不及賓也。"
    },
    {
      "position": 3,
      "name": "九三",
      "text": "九三：臀無膚，其行次且，厲，無大咎。",
      "xiang": "其行次且，行未牽也。"
    },
    {
      "position": 4,
      "name": "九四",
      "text": "九四：包無魚，起凶。",
      "xiang": "無魚之凶，遠民也。"
    },
    {
      "position": 5,
      "name": "九五",
      "text": "九五：以杞包瓜，含章，有隕自天。",
      "xiang": "九五含章，中正也。有隕自天，志不舍命也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：姤其角，吝，無咎。",
      "xiang": "姤其角，上窮吝也。"
    }
  ],
  "aiSummary": ""
