  "guaci": "不利有攸往。",
  "tuan": "剝，剝也，柔變剛也。不利有攸往，小人長也。順而止之，觀象也。君子尚消息盈虛，天行也。",
  "xiang": "山附于地，剝。上以厚下，安宅。",
  "yaoci": [
    {
      "position": 1,
      "name": "初六",
      "text": "初六：剝床以足，蔑貞凶。",
      "xiang": "剝床以足，以滅下也。"
    },
    {
      "position": 2,
      "name": "六二",
      "text": "六二：剝床以辨，蔑貞凶。",
      "xiang": "剝床以辨，未有與也。"
    },
    {
      "position": 3,
      "name": "六三",
      "text": "六三：剝之，無咎。",
      "xiang": "剝之無咎，失上下也。"
    },
    {
      "position": 4,
      "name": "六四",
      "text": "六四：剝床以膚，凶。",
      "xiang": "剝床以膚，切近災也。"
    },
    {
      "position": 5,
      "name": "六五",
      "text": "六五：貫魚，以宮人寵，無不利。",
      "xiang": "以宮人寵，終無尤也。"
    },
    {
      "position": 6,
      "name": "上九",
      "text": "上九：碩果不食，君子得輿，小人剝廬。",
      "xiang": "君子得輿，民所載也。小人剝廬，終不可用也。"
    }
  ],
