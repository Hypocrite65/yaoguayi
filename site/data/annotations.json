  "glossary": {
    "元亨利贞": {
      "term": "元亨利贞",
      "pinyin": "yuán hēng lì zhēn",
      "meaning": "易经中最重要的四个字，被称为"乾之四德"。元：大、起始；亨：通达、顺利；利：利益、和谐；贞：正固、坚守正道。合在一起表示从起始到通达、到和谐、到坚守正道的完整过程。"
    },
    "彖传": {
      "term": "彖传",
      "pinyin": "tuàn zhuàn",
      "meaning": "《易传》的组成部分之一，解释卦辞的义理。彖，断也，即判断一卦之义。相传为孔子所作。"
    },
    "象传": {
      "term": "象传",
      "pinyin": "xiàng zhuàn",
      "meaning": "《易传》的组成部分之一，分大象传和小象传。大象传解释全卦的象征意义和君子应有的行为；小象传解释各爻的象征意义。"
    },
    "九": {
      "term": "九",
      "pinyin": "jiǔ",
      "meaning": "阳爻的代称。因为蓍草占卦时阳爻的数值为九（老阳），故以九代称阳爻。如"初九"指第一爻为阳爻。"
    },
    "六": {
      "term": "六",
      "pinyin": "liù",
      "meaning": "阴爻的代称。因为蓍草占卦时阴爻的数值为六（老阴），故以六代称阴爻。如"六二"指第二爻为阴爻。"
    },
    "初": {
      "term": "初",
      "pinyin": "chū",
      "meaning": "爻位名称，指卦的最下面（第一）爻。六爻从下到上分别称为：初、二、三、四、五、上。"
    },
    "上": {
      "term": "上",
      "pinyin": "shàng",
      "meaning": "爻位名称，指卦的最上面（第六）爻。如"上九"指最上面的阳爻，"上六"指最上面的阴爻。"
    },
    "用九": {
      "term": "用九",
      "pinyin": "yòng jiǔ",
      "meaning": "乾卦特有的爻辞。当六爻全部是老阳（变爻）时使用此爻辞。表示六阳皆动的特殊情况。"
    },
    "用六": {
      "term": "用六",
      "pinyin": "yòng liù",
      "meaning": "坤卦特有的爻辞。当六爻全部是老阴（变爻）时使用此爻辞。表示六阴皆动的特殊情况。"
    },
    "吉": {
      "term": "吉",
      "pinyin": "jí",
      "meaning": "断辞用语，表示吉祥、好的结果。是最好的判断词。"
    },
    "凶": {
      "term": "凶",
      "pinyin": "xiōng",
      "meaning": "断辞用语，表示凶险、不好的结果。与"吉"相对。"
    },
    "悔": {
      "term": "悔",
      "pinyin": "huǐ",
      "meaning": "断辞用语，表示有忧虑悔恨，但程度较轻。处于凶与吉之间偏向吉的一面。"
    },
    "吝": {
      "term": "吝",
      "pinyin": "lìn",
      "meaning": "断辞用语，表示困难、艰涩、羞耻。程度比"悔"重，但比"凶"轻。"
    },
    "咎": {
      "term": "咎",
      "pinyin": "jiù",
      "meaning": "断辞用语，表示灾祸、过失。"无咎"意为没有灾祸，是常见的判断词。"
    },
    "厉": {
      "term": "厉",
      "pinyin": "lì",
      "meaning": "断辞用语，表示危险、警惕。提示需要谨慎应对当前处境。"
    },
    "乘刚": {
      "term": "乘刚",
      "pinyin": "chéng gāng",
      "meaning": "易学术语。阴爻居于阳爻之上称为"乘刚"。阴乘阳被认为是不正常的、有风险的状态。"
    },
    "承柔": {
      "term": "承柔",
      "pinyin": "chéng róu",
      "meaning": "易学术语。阳爻居于阴爻之下称为"承柔"，意为阳爻承接柔爻。"
    },
    "得中": {
      "term": "得中",
      "pinyin": "dé zhōng",
      "meaning": "易学术语。爻处于卦的二或五位（中位）称为"得中"。居中位被视为吉利，象征中庸适当。"
    },
    "当位": {
      "term": "当位",
      "pinyin": "dāng wèi",
      "meaning": "易学术语。阳爻居于奇数位（初、三、五）、阴爻居于偶数位（二、四、上）称为"当位"或"得位"。"
    },
    "相应": {
      "term": "相应",
      "pinyin": "xiāng yìng",
      "meaning": "易学术语。初与四、二与五、三与上的爻位之间如果一阴一阳，称为"相应"。相应表示两爻之间有沟通与配合。"
    }
  }
}
