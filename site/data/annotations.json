  "glossary": {
    "卦": {
      "pinyin": "guà",
      "meaning": "「卦」是六条「爻」画成的符号，一共 64 种。可以把它理解成 64 种人生情境，每个卦讲一种处境和应对办法。",
      "term": "卦"
    },
    "爻": {
      "pinyin": "yáo",
      "meaning": "组成卦的每一画。阳爻画成「—」，阴爻画成「––」。六爻从下往上排，代表事情从开始到结束的发展过程。",
      "term": "爻"
    },
    "卦辭": {
      "pinyin": "guà cí",
      "meaning": "每个卦开头那段总说明，概括这个卦在讲什么。比如乾卦的卦辞是「元，亨，利，貞」。",
      "term": "卦辭"
    },
    "爻辭": {
      "pinyin": "yáo cí",
      "meaning": "每一爻下面的说明文字，讲处在那个位置会遇到什么、该怎么做。看卦主要看爻辞。",
      "term": "爻辭"
    },
    "九": {
      "pinyin": "jiǔ",
      "meaning": "「九」是阳爻（—）的代号。爻的名字这样认：「初九」是第一爻阳爻，「九二」是第二爻阳爻，「九五」是第五爻阳爻，依此类推。",
      "term": "九"
    },
    "六": {
      "pinyin": "liù",
      "meaning": "「六」是阴爻（––）的代号。「初六」是第一爻阴爻，「六二」是第二爻阴爻，「上六」是最上面那爻阴爻。",
      "term": "六"
    },
    "初": {
      "pinyin": "chū",
      "meaning": "六爻从下往上数：初、二、三、四、五、上。「初」是最底下那一爻，代表事情的开端。",
      "term": "初"
    },
    "上": {
      "pinyin": "shàng",
      "meaning": "最顶上那一爻（第六爻），代表事情发展到头了。「上九」是最上面的阳爻，「上六」是最上面的阴爻。",
      "term": "上"
    },
    "用九": {
      "pinyin": "yòng jiǔ",
      "meaning": "乾卦的特殊爻辞。只有六爻全是阳爻时才看这一条，平时用不上。",
      "term": "用九"
    },
    "用六": {
      "pinyin": "yòng liù",
      "meaning": "坤卦的特殊爻辞。只有六爻全是阴爻时才看这一条，平时用不上。",
      "term": "用六"
    },
    "變爻": {
      "pinyin": "biàn yáo",
      "meaning": "起卦时「动」的那一爻。解卦主要看变爻：只有一个变爻，就看它的爻辞。",
      "term": "變爻"
    },
    "綜卦": {
      "pinyin": "zōng guà",
      "meaning": "把一个卦倒过来看（上下翻转）得到的卦。比如屯卦倒过来就是蒙卦。详情页「关联卦象」里可以直接跳转。",
      "term": "綜卦"
    },
    "錯卦": {
      "pinyin": "cuò guà",
      "meaning": "把一个卦的阴阳全部反过来（阳变阴、阴变阳）得到的卦，代表相反的处境。",
      "term": "錯卦"
    },
    "互卦": {
      "pinyin": "hù guà",
      "meaning": "取原卦中间四爻组成的新卦：二三四爻作下卦，三四五爻作上卦。它藏在原卦内部，代表事情暗藏的趋势。",
      "term": "互卦"
    },
    "吉": {
      "pinyin": "jí",
      "meaning": "好结果，卦里最好的评价。看到就是好事。",
      "term": "吉"
    },
    "凶": {
      "pinyin": "xiōng",
      "meaning": "坏结果，卦里最差的评价。提醒你这事有危险。",
      "term": "凶"
    },
    "悔": {
      "pinyin": "huǐ",
      "meaning": "有点后悔、犯愁，但问题不大，整体偏向好的一面。",
      "term": "悔"
    },
    "吝": {
      "pinyin": "lìn",
      "meaning": "艰难、不顺、让人为难。比「悔」严重，比「凶」轻一点。",
      "term": "吝"
    },
    "咎": {
      "pinyin": "jiù",
      "meaning": "灾祸、过错。「无咎」就是「没有灾祸」，是很常见的评价：不算大吉，但至少不出事。",
      "term": "咎"
    },
    "厲": {
      "pinyin": "lì",
      "meaning": "危险警告！看到这个字，就是提醒你「这一步要格外小心」。",
      "term": "厲"
    },
    "貞吉": {
      "pinyin": "zhēn jí",
      "meaning": "「守正就吉利」。「貞」是坚持正道、行得正。只要做人做事端正，结果就是好的。出现频率极高。",
      "term": "貞吉"
    },
    "元亨利貞": {
      "pinyin": "yuán hēng lì zhēn",
      "meaning": "四个最常见的字。元是开始，亨是顺利，利是有利，貞是守正。连起来就是：好的开始、顺利发展、有所收获、坚持正道。",
      "term": "元亨利貞"
    },
    "利涉大川": {
      "pinyin": "lì shè dà chuān",
      "meaning": "原意「利于渡过大河」。大河难渡，所以表示「可以去做大事、放手去闯」。",
      "term": "利涉大川"
    },
    "利見大人": {
      "pinyin": "lì jiàn dà rén",
      "meaning": "「利于去见大人物」。大人指有德行、有能力的人，就是说「去请教贵人对你有好处」。",
      "term": "利見大人"
    },
    "利有攸往": {
      "pinyin": "lì yǒu yōu wǎng",
      "meaning": "「利于有所前往」。别干等着，行动起来对你有利。",
      "term": "利有攸往"
    },
    "無攸利": {
      "pinyin": "wú yōu lì",
      "meaning": "「没有什么好处」。看到这三个字，就是告诉你「这事做了也白做」。",
      "term": "無攸利"
    },
    "彖傳": {
      "pinyin": "tuàn zhuàn",
      "meaning": "专门解释「卦辞」的古文。卦辞看不懂时，可以看彖传的讲解，相当于官方注释。",
      "term": "彖傳"
    },
    "象傳": {
      "pinyin": "xiàng zhuàn",
      "meaning": "解释卦象和爻辞的古文，分两种：「大象」讲整个卦的道理（比如「天行健，君子以自强不息」），「小象」逐条讲每一爻。",
      "term": "象傳"
    },
    "得中": {
      "pinyin": "dé zhōng",
      "meaning": "爻落在二爻或五爻的位置（上下卦各自的中间），象征做事恰到好处、不偏不倚，是好位置。",
      "term": "得中"
    },
    "當位": {
      "pinyin": "dāng wèi",
      "meaning": "阳爻（—）宜居单数位（初、三、五），阴爻（––）宜居双数位（二、四、上）。各就其位叫「当位」，位置摆对了。",
      "term": "當位"
    },
    "乘剛": {
      "pinyin": "chéng gāng",
      "meaning": "阴爻（––）压在阳爻（—）上面，像以弱凌强，位置不太顺，有风险，要当心。",
      "term": "乘剛"
    },
    "承柔": {
      "pinyin": "chéng róu",
      "meaning": "阳爻（—）在阴爻（––）下面，像人托着东西，上下顺承，位置比较安稳。",
      "term": "承柔"
    },
    "相應": {
      "pinyin": "xiāng yìng",
      "meaning": "初与四、二与五、三与上，一阴一阳互相呼应，像两个人一唱一和，表示有配合、有回应。",
      "term": "相應"
    }
  }
}